
local gameId = game.PlaceId

local scripts = {
    -- Murder Mystery 2
    [142823291] = "https://raw.githubusercontent.com/iwannaplaygame0-lab/MM2/refs/heads/main/nothing%20hub%20mm2.txt",

    -- Blox Fruits
    [2753915549] = "https://raw.githubusercontent.com/iwannaplaygame0-lab/Blox-fruit/refs/heads/main/blox%20fruit.txt",

    -- Other game
    [10449761463] = ""
}

local url = scripts[gameId]

if url and url ~= "" then
    local success, err = pcall(function()
        loadstring(game:HttpGet(url))()
    end)

    if not success then
        warn("Script failed to load: " .. tostring(err))
    end
else
    warn("No script available for this game ID: " .. tostring(gameId))
end
